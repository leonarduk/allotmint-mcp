# Java MCP server settings. Copy this file to .env for local development;
# real process environment variables take precedence over values in .env.
ALLOTMINT_API_BASE=http://localhost:8000
ALLOTMINT_MCP_AUTH_TOKEN=
ALLOTMINT_API_CONNECT_TIMEOUT_SECONDS=5
ALLOTMINT_API_READ_TIMEOUT_SECONDS=15
ALLOTMINT_MCP_RESEARCH_ENABLED=false
ALLOTMINT_RESEARCH_BASE_URL=http://localhost:8100
ALLOTMINT_RESEARCH_CONNECT_TIMEOUT_SECONDS=5
ALLOTMINT_RESEARCH_READ_TIMEOUT_SECONDS=180

# Copy to `.env` (gitignored) and uncomment what you need. `docker compose`
# loads `.env` from the repo root automatically - no export/sourcing needed.
# Full variable reference: research-agent/README.md#configuration

# --- Cloud LLM for the research-agent sidecar -------------------------------
# Unset (default): local Ollama, $0 cost, needs `ollama serve` reachable from
# the research-agent container. Uncomment these to use a hosted model instead
# - useful when a local model's context window or tool-calling quality isn't
# enough (e.g. a large allotmint_portfolio result blowing past a small local
# model's context limit).
#
# ALLOTMINT_RESEARCH_LLM_PROVIDER=deepseek
# ALLOTMINT_RESEARCH_LLM_MODEL=deepseek-chat
# ALLOTMINT_RESEARCH_LLM_API_KEY=sk-...
#
# Any other OpenAI-compatible endpoint (OpenAI itself, OpenRouter, a hosted
# gateway) works the same way:
#
# ALLOTMINT_RESEARCH_LLM_PROVIDER=openai-compatible
# ALLOTMINT_RESEARCH_LLM_MODEL=gpt-4o-mini
# ALLOTMINT_RESEARCH_LLM_BASE_URL=https://api.openai.com/v1
# ALLOTMINT_RESEARCH_LLM_API_KEY=sk-...
