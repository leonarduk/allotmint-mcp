<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.allotmint.mcp</groupId>
	<artifactId>allotmint-mcp</artifactId>
	<version>0.0.2-SNAPSHOT</version>
	<name>allotmint-mcp</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
		<!-- Keep every Log4j module on the patched release. In particular, Spring Boot
		     4.1.0 otherwise manages log4j-to-slf4j at vulnerable version 2.25.4. -->
		<log4j2.version>2.26.1</log4j2.version>
		<!-- Excludes @Tag("integration") tests (see AllotMintClientIntegrationTest) from the
		     default mvn test/verify run, since they require a live AWS-deployed backend and a
		     real, short-lived auth token. The "integration" profile below clears this property
		     to opt in explicitly. -->
		<surefire.excludedGroups>integration</surefire.excludedGroups>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.modelcontextprotocol.sdk</groupId>
				<artifactId>mcp-bom</artifactId>
				<version>2.0.0</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Override transitive versions pulled in by spring-boot-starter-parent 4.1.0
			     that OWASP dependency-check (see the plugin below) flagged with CVSS >= 9
			     critical CVEs; both have patched releases available.
			     tomcat-embed-el/-websocket weren't individually flagged but are bumped to
			     match tomcat-embed-core: Tomcat's embed modules are a matched set and
			     mixing versions across them isn't a supported/tested combination. -->
			<dependency>
				<groupId>org.apache.tomcat.embed</groupId>
				<artifactId>tomcat-embed-core</artifactId>
				<version>11.0.24</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat.embed</groupId>
				<artifactId>tomcat-embed-el</artifactId>
				<version>11.0.24</version>
			</dependency>
			<dependency>
				<groupId>org.apache.tomcat.embed</groupId>
				<artifactId>tomcat-embed-websocket</artifactId>
				<version>11.0.24</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>io.modelcontextprotocol.sdk</groupId>
			<artifactId>mcp-spring-webmvc</artifactId>
			<version>0.18.3</version>
		</dependency>

		<dependency>
			<groupId>io.modelcontextprotocol.sdk</groupId>
			<artifactId>mcp</artifactId>
		</dependency>

		<!-- Exposes a local .env file as a low-priority Spring PropertySource. Real
		     environment variables and JVM properties continue to take precedence. -->
		<dependency>
			<groupId>me.paulschwarz</groupId>
			<artifactId>springboot4-dotenv</artifactId>
			<version>5.1.0</version>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
			<!-- Version needed for Java 25 -->
			<version>1.18.46</version>
		</dependency>

		<!-- JSON encoder for logback-spring.xml, toggled at runtime via
		     ALLOTMINT_MCP_LOG_JSON=true (default: unset, plain-text logging).
		     Not marked optional: spring-boot-maven-plugin's repackage goal drops
		     optional dependencies from the executable fat jar, which would leave
		     this (and janino, below) off the runtime classpath entirely and crash
		     logback's config parsing on startup regardless of the env var. -->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
			<version>8.0</version>
		</dependency>

		<!-- Required for the <if>/<then>/<else> conditional in logback-spring.xml that
		     switches the encoder based on ALLOTMINT_MCP_LOG_JSON. Not pulled in
		     transitively by spring-boot-starter-logging. -->
		<dependency>
			<groupId>org.codehaus.janino</groupId>
			<artifactId>janino</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<version>4.1.0</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webmvc-test</artifactId>
			<version>4.1.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>allotmint-mcp-server</finalName>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>1.18.46</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>resolve-mockito-agent</id>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- Load Mockito's inline-mock-maker agent statically instead of letting it
					     self-attach at runtime: the dynamic self-attach can leave the forked test
					     JVM unable to exit cleanly, which under CI's tighter resource limits has
					     caused Surefire to force-kill the fork before JaCoco's exit-time dump of
					     jacoco.exec runs - silently zeroing out the coverage the check goal below
					     enforces. -->
					<argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
					<excludedGroups>${surefire.excludedGroups}</excludedGroups>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<!-- Packaging smoke test (FatJarSmokeIT) depends on target/${project.build.finalName}.jar,
					     which the spring-boot-maven-plugin repackage goal produces during the package
					     phase - already complete by the time Failsafe's integration-test phase runs. -->
					<systemPropertyVariables>
						<allotmint.mcp.smokeTest.fatJar>${project.build.directory}/${project.build.finalName}.jar</allotmint.mcp.smokeTest.fatJar>
					</systemPropertyVariables>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>3.10.0</version>
				<configuration>
					<java>
						<googleJavaFormat/>
						<removeUnusedImports/>
						<importOrder>
							<order>,javax,java,\#</order>
						</importOrder>
					</java>
				</configuration>
				<executions>
					<execution>
						<id>spotless-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<!-- Baseline instruction coverage measured via `mvn verify` was 80.41%; -->
										<!-- threshold set with a small buffer below that to guard against regression. -->
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.78</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<version>13.0.0</version>
				<configuration>
					<!-- Conservative starting threshold: fail only on critical findings until
					     the existing dependency tree's baseline has been triaged. -->
					<failBuildOnCVSS>9</failBuildOnCVSS>
					<!-- Without an NVD API key, the first-time data sync can take ~2 hours
					     (NVD rate-limits anonymous requests); set NVD_API_KEY in CI (see
					     https://nvd.nist.gov/developers/request-an-api-key) to speed this up.
					     Reading via env var (not the nvdApiKey property) avoids leaking the
					     key through Maven debug logging - see GHSA-qqhq-8r2c-c3f5. -->
					<nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
					<!-- Fixed, cache-friendly location so CI can persist the NVD database
					     between runs instead of re-syncing it every time. -->
					<dataDirectory>${project.basedir}/.dependency-check-data</dataDirectory>
				</configuration>
				<executions>
					<execution>
						<id>dependency-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
		Opts in to the @Tag("integration") tests (see AllotMintClientIntegrationTest) that the
		default build excludes, since they need a live AWS-deployed AllotMint backend and a
		real, short-lived auth token. Those tests skip themselves via Assumptions.assumeTrue
		if the required env vars aren't set, so activating this profile without them is safe -
		it just re-confirms the skip. Run explicitly with:

		mvn test -Pintegration -DALLOTMINT_API_BASE=https://your-allotmint-backend.example.com -DALLOTMINT_MCP_AUTH_TOKEN=<backend-issued-jwt>
		-->
		<profile>
			<id>integration</id>
			<properties>
				<surefire.excludedGroups/>
			</properties>
		</profile>
	</profiles>

</project>
